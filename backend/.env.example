# Copy to .env and fill in.

PGUSER=doadmin
PGPASSWORD=
PGHOST=
PGPORT=25060
PGDATABASE=defaultdb
PGSSLMODE=require

PORT=3000
NODE_ENV=development

ADMIN_NAME=Chantallow Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional regular customer login (role "user") — can only use /account pages.
USER_NAME=Demo Customer
USER_EMAIL=user@example.com
USER_PASSWORD=

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

CLIENT_ORIGIN=http://localhost:5173
