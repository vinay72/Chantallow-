# Copy to .env and fill in.

PGUSER=doadmin
PGPASSWORD=
PGHOST=
PGPORT=25060
PGDATABASE=defaultdb
PGSSLMODE=require

PORT=3000
NODE_ENV=development

ADMIN_NAME=Chantallow Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional regular customer login (role "user") — can only use /account pages.
USER_NAME=Demo Customer
USER_EMAIL=user@example.com
USER_PASSWORD=

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

CLIENT_ORIGIN=http://localhost:5173

# SMTP — used to send password-reset emails. For Gmail, SMTP_USER is your
# address and SMTP_PASS is an "App Password" (not your real password); create
# one at myaccount.google.com/apppasswords. For another provider, use the
# host/port/user/pass they give you.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Shown as the "From" name/address on reset emails. Defaults to SMTP_USER if left blank.
SMTP_FROM="Chantallow <no-reply@chantallow.com>"
